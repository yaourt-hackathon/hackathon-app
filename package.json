{
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/eslint-plugin-query": "^5.107.1",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-query-devtools": "5.107.1",
    "@tanstack/react-router-devtools": "1.167.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && npm run api:generate",
    "dev": "vite dev",
    "predev": "npm run api:generate",
    "build": "vite build",
    "prebuild": "npm run api:generate",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run api:generate && npm run lint && npm run typecheck && npm run test && npm run format:check",
    "api:pull": "node --env-file-if-exists=.env scripts/api-pull.ts && prettier --write openapi/data-api.json && npm run api:generate",
    "api:generate": "openapi-ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,css}": "prettier --write"
  },
  "name": "hackathon-app",
  "private": "true",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource-variable/jost": "5.3.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "nitro": "3.0.261103-rc",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
